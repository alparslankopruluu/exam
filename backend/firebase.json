{
  "functions": { "source": "functions" },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
